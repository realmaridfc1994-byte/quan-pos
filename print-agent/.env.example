# Print Agent — Cấu hình

# Thư mục chứa hàng đợi công việc in (file .bin sinh bởi Laravel)
# Đường dẫn tương đối hoặc tuyệt đối.
QUEUE_DIR=./queue

# Mã định danh máy in nhiệt:
# Tìm bằng:  lsusb (Linux) hoặc Device Manager (Windows)
# Ví dụ: Thermal Printer QPRINTER-80 có VID=0x04B8, PID=0x0202
PRINTER_VENDOR_ID=0x04b8
PRINTER_PRODUCT_ID=0x0202

# Khoảng cách giữa hai lần kiểm tra hàng đợi (millisecond)
# 1000ms = kiểm tra 1 lần/giây (mất ít tài nguyên)
POLL_INTERVAL=1000

# Thư mục lưu log
LOG_DIR=./logs
